# Backend Environment Configuration Template
# Copy this file to .env and fill in your real values

# Security & Authentication
SECRET_KEY=your_super_secret_jwt_key_here_generate_with_openssl
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection URL
# Local SQLite example:
# DATABASE_URL=sqlite:///./hostel.db
# Cloud PostgreSQL (Neon / Supabase / Render) pooled example:
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Gmail SMTP Email Relay Service (for OTP Dispatch)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_institution_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
COLLEGE_LOGO_URL=https://files.catbox.moe/8czd78.png